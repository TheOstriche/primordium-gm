  "damageVsArmor": {
    "formula": "dpt(A) = unarmoredDPT - (unarmoredDPT - armoredDPT) * A / referenceArmor",
    "note": "Linear between unarmored (armor 0) and armored (armor = referenceArmor); extrapolates past it. Floor at 1."
  },
  "roles": {
    "Minion": {
      "playerTurnsToKill": 1,
      "turnsToDropPlayer": 10,
      "xpMultiplier": 0.25,
      "turnsPerPhase": 1
    },
    "Standard": {
      "playerTurnsToKill": 2.5,
      "turnsToDropPlayer": 5,
      "xpMultiplier": 1,
      "turnsPerPhase": 1
    },
    "Elite": {
      "playerTurnsToKill": 6,
      "turnsToDropPlayer": 3,
      "xpMultiplier": 3,
      "turnsPerPhase": 1,
      "minTactics": "Fair"
    },
    "Boss": {
      "playerTurnsToKill": 20,
      "turnsToDropPlayer": 2,
      "xpMultiplier": 10,
      "turnsPerPhase": 2,
      "minTactics": "Fair"
    }
  },
  "budgetFormulas": {
    "enemyHP": "role.playerTurnsToKill * steps[s].playerDamagePerTurn * armorClass.hpMultiplier",
    "enemyDamagePerTurn": "steps[s].playerHP / role.turnsToDropPlayer + steps[s].playerArmor",
    "enemyArmor": "round(steps[s].referenceArmor * armorClass.armorMultiplier)",
    "basicAbility": "enemyDamagePerTurn / tacticsMultiplier"
  },
